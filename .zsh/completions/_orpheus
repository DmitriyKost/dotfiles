#compdef orpheus

autoload -U is-at-least

_orpheus() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--music-dir=[Override the configured music directory]:MUSIC_DIR:_files' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_orpheus_commands" \
"*::: :->orpheus" \
&& ret=0
    case $state in
    (orpheus)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:orpheus-command-$line[1]:"
        case $line[1] in
            (tui)
_arguments "${_arguments_options[@]}" : \
'--music-dir=[Override the configured music directory]:MUSIC_DIR:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(scan)
_arguments "${_arguments_options[@]}" : \
'--music-dir=[Override the configured music directory]:MUSIC_DIR:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(play)
_arguments "${_arguments_options[@]}" : \
'--music-dir=[Override the configured music directory]:MUSIC_DIR:_files' \
'--background[Start playback in a detached process and return immediately]' \
'-h[Print help]' \
'--help[Print help]' \
'::input:_default' \
&& ret=0
;;
(stop)
_arguments "${_arguments_options[@]}" : \
'--music-dir=[Override the configured music directory]:MUSIC_DIR:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'--music-dir=[Override the configured music directory]:MUSIC_DIR:_files' \
'-h[Print help]' \
'--help[Print help]' \
':shell:(bash elvish fish power-shell zsh)' \
&& ret=0
;;
(play-internal)
_arguments "${_arguments_options[@]}" : \
'--music-dir=[Override the configured music directory]:MUSIC_DIR:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(playlist)
_arguments "${_arguments_options[@]}" : \
'--music-dir=[Override the configured music directory]:MUSIC_DIR:_files' \
'-h[Print help]' \
'--help[Print help]' \
":: :_orpheus__subcmd__playlist_commands" \
"*::: :->playlist" \
&& ret=0

    case $state in
    (playlist)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:orpheus-playlist-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
'--music-dir=[Override the configured music directory]:MUSIC_DIR:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
'--music-dir=[Override the configured music directory]:MUSIC_DIR:_files' \
'-h[Print help]' \
'--help[Print help]' \
':name:_default' \
&& ret=0
;;
(create)
_arguments "${_arguments_options[@]}" : \
'--music-dir=[Override the configured music directory]:MUSIC_DIR:_files' \
'-h[Print help]' \
'--help[Print help]' \
':name:_default' \
&& ret=0
;;
(delete)
_arguments "${_arguments_options[@]}" : \
'--music-dir=[Override the configured music directory]:MUSIC_DIR:_files' \
'-h[Print help]' \
'--help[Print help]' \
':name:_default' \
&& ret=0
;;
(add)
_arguments "${_arguments_options[@]}" : \
'--music-dir=[Override the configured music directory]:MUSIC_DIR:_files' \
'-h[Print help]' \
'--help[Print help]' \
':name:_default' \
'*::files:_files' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_orpheus__subcmd__playlist__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:orpheus-playlist-help-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(create)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(delete)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(add)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_orpheus__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:orpheus-help-command-$line[1]:"
        case $line[1] in
            (tui)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(scan)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(play)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(stop)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(play-internal)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(playlist)
_arguments "${_arguments_options[@]}" : \
":: :_orpheus__subcmd__help__subcmd__playlist_commands" \
"*::: :->playlist" \
&& ret=0

    case $state in
    (playlist)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:orpheus-help-playlist-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(create)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(delete)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(add)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_orpheus_commands] )) ||
_orpheus_commands() {
    local commands; commands=(
'tui:Launch the interactive TUI player' \
'scan:Print all discovered audio files' \
'play:Play a file, directory, playlist name, or the whole library. Blocks until playback finishes' \
'stop:Stop all background Orpheus playback processes' \
'completion:Generate shell completion script' \
'play-internal:' \
'playlist:Manage m3u playlists stored by Orpheus' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'orpheus commands' commands "$@"
}
