# ── appearance ────────────────────────────────────────────────
font=JetBrainsMono Nerd Font 13
background-color=#221E1A
text-color=#F5EFE7
border-color=#352D27
border-size=2
border-radius=6
width=360
height=120
padding=14
margin=10
outer-margin=8,8,0,0

# ── typography ────────────────────────────────────────────────
markup=1
format=<b>%s</b>\n<span color="#847568">%b</span>

# ── icons ─────────────────────────────────────────────────────
icons=1
max-icon-size=40
icon-location=left

# ── layout / position ─────────────────────────────────────────
anchor=top-right
layer=overlay
max-visible=5
sort=-time
group-by=app-name

# ── behavior ──────────────────────────────────────────────────
default-timeout=2500
ignore-timeout=1

# ── progress (e.g. volume/brightness) ─────────────────────────
progress-color=over #6B5E53

# ── per-urgency overrides ─────────────────────────────────────
[urgency=low]
background-color=#141210
border-color=#352D27
text-color=#847568
format=<b>%s</b>\n<span color="#6B5E53">%b</span>
default-timeout=1500

[urgency=normal]
background-color=#221E1A
border-color=#6B5E53
text-color=#F5EFE7
default-timeout=2500

[urgency=critical]
background-color=#141210
border-color=#FF5F6D
text-color=#F5EFE7
format=<b><span color="#FF5F6D">%s</span></b>\n<span color="#F5EFE7">%b</span>
default-timeout=3000

# ── grouped notifications ─────────────────────────────────────
[grouped]
format=<b>%s</b> <span color="#6B5E53">(%g)</span>\n<span color="#847568">%b</span>
default-timeout=2500

# ── keyboard layout OSD ────────────────────────────────────────
[category=input-layout]
anchor=top-right
layer=overlay

font=JetBrainsMono Nerd Font 32
width=96
# no fixed height: let mako size it naturally
padding=12,18
margin=0
outer-margin=72,0,0,0

background-color=#221E1Add
border-color=#6B5E53
border-size=2
border-radius=16
text-color=#F5EFE7

icons=0
format=<span rise="1500"><b>%s</b></span>
text-alignment=center

default-timeout=700
ignore-timeout=1
history=0
