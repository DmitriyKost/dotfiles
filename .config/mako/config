# ── appearance ────────────────────────────────────────────────
font=JetBrainsMono Nerd Font 13

background-color=#080808
text-color=#AFAFAF
border-color=#262626

border-size=2
border-radius=6

width=360
height=120

padding=14
margin=10
outer-margin=8,8,0,0

# ── typography ────────────────────────────────────────────────
markup=1
format=<b>%s</b>\n<span color="#777777">%b</span>

# ── icons ─────────────────────────────────────────────────────
icons=1
max-icon-size=40
icon-location=left

# ── layout / position ─────────────────────────────────────────
anchor=top-right
layer=overlay
max-visible=5
sort=-time
group-by=app-name

# ── behavior ──────────────────────────────────────────────────
default-timeout=2500
ignore-timeout=1

# ── progress (e.g. volume/brightness) ─────────────────────────
progress-color=over #606060

# ── per-urgency overrides ─────────────────────────────────────
[urgency=low]
background-color=#000000
border-color=#1A1A1A
text-color=#777777
format=<b>%s</b>\n<span color="#606060">%b</span>
default-timeout=1500

[urgency=normal]
background-color=#080808
border-color=#303030
text-color=#AFAFAF
format=<b>%s</b>\n<span color="#777777">%b</span>
default-timeout=2500

[urgency=critical]
background-color=#050505
border-color=#B96572
text-color=#C8C8C8
format=<b><span color="#B96572">%s</span></b>\n<span color="#AFAFAF">%b</span>
default-timeout=3000

# ── grouped notifications ─────────────────────────────────────
[grouped]
format=<b>%s</b> <span color="#606060">(%g)</span>\n<span color="#777777">%b</span>
default-timeout=2500

# ── keyboard layout OSD ────────────────────────────────────────
[category=input-layout]
anchor=top-right
layer=overlay

font=JetBrainsMono Nerd Font 32

width=96
# no fixed height: let mako size it naturally
padding=12,18
margin=0
outer-margin=72,0,0,0

background-color=#080808dd
border-color=#303030
border-size=2
border-radius=16

text-color=#AFAFAF
icons=0
format=<span rise="1500"><b>%s</b></span>
text-alignment=center

default-timeout=700
ignore-timeout=1
history=0

# ── volume OSD ────────────────────────────────────────────────
[category=volume]
anchor=top-left
layer=overlay

font=JetBrainsMono Nerd Font 20

width=150
padding=10,16
margin=0
outer-margin=72,0,0,12

background-color=#080808dd
border-color=#303030
border-size=2
border-radius=12

text-color=#AFAFAF
icons=0
format=<span rise="500">%s</span>
text-alignment=center

default-timeout=700
ignore-timeout=1
history=0

# ── brightness OSD ────────────────────────────────────────────
[category=brightness]
anchor=top-left
layer=overlay

font=JetBrainsMono Nerd Font 20

width=150
padding=10,16
margin=0
outer-margin=72,0,0,12

background-color=#080808dd
border-color=#303030
border-size=2
border-radius=12

text-color=#AFAFAF
icons=0
format=<span rise="500">%s</span>
text-alignment=center

default-timeout=700
ignore-timeout=1
history=0
