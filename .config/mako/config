# ── appearance ────────────────────────────────────────────────
font=JetBrainsMono Nerd Font 13
background-color=#141210
text-color=#F5EFE7
border-color=#352D27
border-size=2
border-radius=0
width=360
height=140
padding=14
margin=10
outer-margin=8,8,0,0

# ── typography ────────────────────────────────────────────────
markup=1
format=<b>%s</b>\n<span color="#847568">%b</span>

# ── icons ─────────────────────────────────────────────────────
icons=1
max-icon-size=40
icon-location=left

# ── layout / position ─────────────────────────────────────────
anchor=top-right
layer=overlay
max-visible=5
sort=-time
group-by=app-name

# ── behavior ──────────────────────────────────────────────────
default-timeout=5000
ignore-timeout=0

# ── progress (e.g. volume/brightness) ─────────────────────────
progress-color=over #352D27

# ── per-urgency overrides ─────────────────────────────────────
[urgency=low]
border-color=#6B5E53
text-color=#847568
format=<b>%s</b>\n<span color="#6B5E53">%b</span>
default-timeout=3000

[urgency=normal]
border-color=#352D27
text-color=#F5EFE7
default-timeout=5000

[urgency=critical]
background-color=#141210
border-color=#FF5F6D
text-color=#F5EFE7
format=<b><span color="#FF5F6D">%s</span></b>\n<span color="#F5EFE7">%b</span>
default-timeout=10000

# ── grouped notifications ─────────────────────────────────────
[grouped]
format=<b>%s</b> <span color="#6B5E53">(%g)</span>\n<span color="#847568">%b</span>
