[player]
command=~/.config/i3blocks/player.sh
interval=1
signal=10

[volume]
command=~/.config/i3blocks/volume.sh
interval=30
signal=12

[time]
command=date '+%a %b %d %H:%M:%S'
interval=1

[layout]
command=~/.config/i3blocks/kb_layout.sh
signal=11
interval=once

[system]
command=~/.config/i3blocks/sys_info.sh
interval=5

[nvidia]
command=~/.config/i3blocks/nvidia.sh
interval=5

[vpn]
command=~/.config/i3blocks/vpn.sh
interval=5
signal=21
color=true
