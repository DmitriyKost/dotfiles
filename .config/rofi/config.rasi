configuration {
    show-icons: true;
    modes:      "drun";
    font:       "JetBrainsMono Nerd Font 16";
}

@theme "/dev/null"

* {
    background-color: transparent;
    text-color:       #F5EFE7;
}

window {
    background-color: #141210;
    width:            630px;
    border:           1px solid;
    border-color:     #352D27;
    border-radius:    6px;
    padding:          0;
}

mainbox {
    children: [ inputbar, listview ];
    padding:  10px;
    spacing:  8px;
}

inputbar {
    children:         [ prompt, entry ];
    padding:          6px 8px;
    spacing:          8px;
    background-color: #221E1A;
    border-radius:    6px;
}

prompt {
    text-color: #D8A85F;
    str:        "❯";
}

entry {
    padding:           0;
    placeholder:       "";
    placeholder-color: #6B5E53;
}

listview {
    lines:     8;
    columns:   1;
    scrollbar: false;
    padding:   0;
    spacing:   2px;
}

element {
    padding: 2px 6px;
    spacing: 8px;
}

element selected {
    background-color: #221E1A;
    text-color:       #D8A85F;
    border-radius:    6px;
}

element-icon {
    size:       0.9em;
    text-color: inherit;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
